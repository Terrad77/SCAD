# ── LLM provider ────────────────────────────────────────────────────────────
# openai | anthropic | ollama | opencode | mock
LLM_PROVIDER=mock

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local fallback via Ollama (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# OpenCode CLI (LLM_PROVIDER=opencode)
OPENCODE_MODEL=opencode/big-pickle

# ── Search provider ─────────────────────────────────────────────────────────
# mock (offline, default) | brave | noop
SEARCH_PROVIDER=mock

# Brave Search (SEARCH_PROVIDER=brave)
BRAVE_SEARCH_API_KEY=
BRAVE_BASE_URL=https://api.search.brave.com/res/v1/web/search

# ── Content extraction ──────────────────────────────────────────────────────
# noop (offline snippets, default) | mock (fixtures) | http (real page fetch)
CONTENT_PROVIDER=noop
# Max characters of extracted page text used per source
RESEARCH_MAX_CONTENT=8000

# ── Research engine limits ──────────────────────────────────────────────────
RESEARCH_MAX_QUERIES=10
RESEARCH_MAX_RESULTS=8
RESEARCH_MAX_FOLLOWUP_ROUNDS=1
RESEARCH_MAX_SOURCES=40

# Reproducibility: root freshness + generatedAt at a fixed ISO date instead of "now"
# SCAD_REFERENCE_DATE=2026-01-15

# ── Caching ─────────────────────────────────────────────────────────────────
# Enable persistent JSON caching of search results and extracted content
CACHE_ENABLED=1
# Cache time-to-live in seconds (default: 1 week)
CACHE_TTL=604800
SCAD_CACHE_DIR=data/cache
# Disable search result caching per run (legacy toggle, off by default)
SCAD_SEARCH_CACHE=1

# ── Storage ─────────────────────────────────────────────────────────────────
SCAD_DATA_DIR=data/projects