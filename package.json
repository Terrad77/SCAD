{
  "name": "scad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stellator Cognitive Architecture Driver — a modular AI cognitive pipeline for producing original documentary-film concepts and production plans.",
  "bin": {
    "scad": "dist/cli/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/cli/cli.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/cli/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
